# Copiar este archivo como ".env" y ajustar los valores.

# URL del servicio PHP (PC2). Reemplazar IP_PC2 por la IP de ese computador.
# Para probar los tres servicios en un solo equipo: http://host.docker.internal:8081
PHP_SERVICE_URL=http://IP_PC2:8081

# Puerto de este computador por el que se publica la interfaz y la API.
PUERTO=8080
