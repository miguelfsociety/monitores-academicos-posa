# Copiar este archivo como ".env" y cambiar las claves antes de arrancar.

# Puerto del equipo (host) por el que se publica el servicio Python.
PUERTO=8000

# Base de datos MySQL (solo es visible dentro de la red de Docker).
MYSQL_DATABASE=monitores
MYSQL_USER=monitores
MYSQL_PASSWORD=cambiar_esta_clave
MYSQL_ROOT_PASSWORD=cambiar_esta_clave_root
