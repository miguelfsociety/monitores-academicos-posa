# Copiar este archivo como ".env" y ajustar los valores.

# Puerto del equipo (PC2) por el que se publica el servicio PHP.
PUERTO=8081

# URL base del servidor que atiende cada servicio (sin "/" al final).
# En el despliegue ambas apuntan al Servicio Python de PC3: cambiar IP_PC3 por su IP real,
# por ejemplo http://192.168.1.30:8000
SERVICIO_MONITORES_URL=http://IP_PC3:8000
SERVICIO_MATERIAS_URL=http://IP_PC3:8000

# Para probar todo en un solo equipo (el Python publicado en el puerto 8000 del mismo PC):
# SERVICIO_MONITORES_URL=http://host.docker.internal:8000
# SERVICIO_MATERIAS_URL=http://host.docker.internal:8000
